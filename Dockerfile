# Этот файл объясняет серверу Dokploy, как собрать и запустить наш мессенджер.
# Специального языка тут знать не нужно — просто набор команд.

# 1. Берём готовый образ с Node.js (версия 22 в полном варианте,
#    чтобы все дополнительные детали точно установились).
FROM node:22-bookworm

# 2. Рабочая папка внутри сервера.
WORKDIR /app

# 3. Сначала копируем список зависимостей и ставим их.
#    Так при следующих сборках они не будут скачиваться заново.
COPY package.json ./
RUN npm install --omit=dev

# 4. Копируем весь остальной код.
COPY . .

# 5. Где хранить базу данных (файл). Эту папку нужно «подключить»
#    к постоянному хранилищу в Dokploy — тогда переписка не пропадёт.
ENV DATA_DIR=/app/data
ENV PORT=3000
RUN mkdir -p /app/data

# 6. Открываем наружу порт 3000.
EXPOSE 3000

# 7. Команда запуска.
CMD ["node", "server.js"]
