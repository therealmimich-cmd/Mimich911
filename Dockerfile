# Этот файл объясняет серверу Dokploy, как собрать и запустить наш мессенджер.

# 1. Берём готовый образ с Node.js версии 24.
#    В нём уже «из коробки» есть и база данных SQLite — ничего компилировать не нужно.
FROM node:24

# 2. Рабочая папка внутри сервера.
WORKDIR /app

# 3. Сначала копируем список зависимостей и ставим их.
COPY package.json ./
RUN npm install --omit=dev

# 4. Копируем весь остальной код.
COPY . .

# 5. Где хранить базу данных. Эту папку нужно «подключить»
#    к постоянному хранилищу в Dokploy — тогда переписка не пропадёт.
ENV DATA_DIR=/app/data
ENV PORT=3000
RUN mkdir -p /app/data

# 6. Открываем наружу порт 3000.
EXPOSE 3000

# 7. Команда запуска.
CMD ["node", "--no-warnings", "server.js"]
